 "nodes": [
  {"id": "script", "lane": "direct", "col": 0, "type": "frontend", "label": "腳本＋分鏡表", "sublabel": "project.json board", "explanation": "先問清楚用途、片長、預算、角色；分鏡欄位（景別、節拍、表演、聲音、後製）寫進 project.json，storyboard.py 產生分鏡表 PDF。"},
  {"id": "confirm", "lane": "direct", "col": 1, "type": "security", "label": "使用者確認", "sublabel": "長度、預算、分鏡", "tag": "花點數前"},
  {"id": "flowvideo", "lane": "flow", "col": 2, "type": "cloud", "label": "Flow 真人鏡頭", "sublabel": "角色→影格→核准→影片", "tag": "每鏡 ≤ 8 秒", "explanation": "只負責人：出鏡、表情、動作、說話。每支影片都要核准；螢幕只發光不顯示文字。"},
  {"id": "composite", "lane": "flow", "col": 3, "type": "backend", "label": "螢幕畫面合成", "sublabel": "追蹤貼合／全螢幕插入"},
  {"id": "voice", "lane": "assets", "col": 2, "type": "backend", "label": "旁白", "sublabel": "Flow 試聽／tts.py／錄音", "tag": "不扣點"},
  {"id": "anim", "lane": "assets", "col": 3, "type": "backend", "label": "程式動畫", "sublabel": "make_anim.py", "explanation": "HTML 動畫依旁白長度排時間點，逐格輸出並混入旁白；文字、數字、程式碼、字卡都在這裡做。"},
  {"id": "assemble", "lane": "output", "col": 4, "type": "backend", "label": "組裝＋字幕", "sublabel": "assemble.py"},
  {"id": "qa", "lane": "output", "col": 5, "type": "security", "label": "驗收", "sublabel": "qa.py＋人工試聽"},
  {"id": "deliver", "lane": "direct", "col": 5, "type": "database", "label": "交付", "sublabel": "成品＋分鏡表 PDF"}
 ],
 "edges": [
  {"id": "e-script-confirm", "from": "script", "to": "confirm"},
