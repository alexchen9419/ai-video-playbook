{
 "schema_version": 2,
 "diagram_type": "workflow",
 "meta": {
  "title": "AI Video Production Pipeline",
  "locale": "en",
  "quality_profile": "showcase",
  "output": "docs/overall-pipeline.html",
  "legend": {
   "entries": {
    "frontend": {
     "label": "Directing"
    },
    "cloud": {
     "label": "Google Flow (costs credits)"
    },
    "security": {
     "label": "Approval & QA"
    },
    "backend": {
     "label": "Local tools"
    },
    "database": {
     "label": "Delivery"
    }
   }
  }
 },
 "lanes": [
  {
   "id": "direct",
   "label": "Directing"
  },
  {
   "id": "flow",
   "label": "Live-action shots"
  },
  {
   "id": "assets",
   "label": "Narration & animation"
  },
  {
   "id": "output",
   "label": "Assembly & output"
  }
 ],
 "phases": [
  {
   "id": "p-plan",
   "label": "01 Direct",
   "fromCol": 0,
   "toCol": 1
  },
  {
   "id": "p-make",
   "label": "02–03 Generate & post",
   "fromCol": 2,
   "toCol": 3,
   "variant": "emphasis"
  },
  {
   "id": "p-out",
   "label": "04 Output & QA",
   "fromCol": 4,
   "toCol": 5
  }
 ],
 "mainPath": [
  "script",
  "confirm",
  "voice",
  "anim",
  "assemble",
  "qa",
  "deliver"
 ],
 "nodes": [
  {
   "id": "script",
   "lane": "direct",
   "col": 0,
   "type": "frontend",
   "label": "Script + storyboard",
   "sublabel": "project.json board",
   "explanation": "Ask about purpose, length, budget and cast first; storyboard fields (shot size, beats, action, sound, post) live in project.json, and storyboard.py renders the storyboard PDF."
  },
  {
   "id": "confirm",
   "lane": "direct",
   "col": 1,
   "type": "security",
   "label": "User approval",
   "sublabel": "length, budget, storyboard",
   "tag": "before spending"
  },
  {
   "id": "flowvideo",
   "lane": "flow",
   "col": 2,
   "type": "cloud",
   "label": "Flow live-action shots",
   "sublabel": "character→keyframe→approve→video",
   "tag": "≤ 8 s per shot",
   "explanation": "People only: appearance, expression, movement, speech. Approve every video; screens glow without text."
  },
  {
   "id": "composite",
   "lane": "flow",
   "col": 3,
   "type": "backend",
   "label": "Screen compositing",
   "sublabel": "tracking / full-screen insert"
  },
  {
   "id": "voice",
   "lane": "assets",
   "col": 2,
   "type": "backend",
   "label": "Narration",
   "sublabel": "Flow preview / tts.py / recording",
   "tag": "free"
  },
  {
   "id": "anim",
   "lane": "assets",
   "col": 3,
   "type": "backend",
   "label": "Code animation",
   "sublabel": "make_anim.py",
   "explanation": "HTML animation timed from the narration length, rendered frame by frame with the narration mixed in; all text, numbers, code and title cards are made here."
  },
  {
   "id": "assemble",
   "lane": "output",
   "col": 4,
   "type": "backend",
   "label": "Assemble + subtitles",
   "sublabel": "assemble.py"
  },
  {
   "id": "qa",
   "lane": "output",
   "col": 5,
   "type": "security",
   "label": "Acceptance",
   "sublabel": "qa.py + human listening"
  },
  {
   "id": "deliver",
   "lane": "direct",
   "col": 5,
   "type": "database",
   "label": "Deliver",
   "sublabel": "video + storyboard PDF"
  }
 ],
 "edges": [
  {
   "id": "e-script-confirm",
   "from": "script",
   "to": "confirm"
  },
  {
   "id": "e-confirm-flow",
   "from": "confirm",
   "to": "flowvideo",
   "label": "has on-camera people",
   "role": "branch",
   "fromSide": "right",
   "toSide": "top"
  },
  {
   "id": "e-confirm-voice",
   "from": "confirm",
   "to": "voice",
   "label": "narration script",
   "variant": "emphasis",
   "fromSide": "bottom",
   "toSide": "left"
  },
  {
   "id": "e-flow-comp",
   "from": "flowvideo",
   "to": "composite",
   "label": "720p download"
  },
  {
   "id": "e-voice-anim",
   "from": "voice",
   "to": "anim",
   "label": "length sets timing",
   "variant": "emphasis"
  },
  {
   "id": "e-comp-assemble",
   "from": "composite",
   "to": "assemble",
   "label": "videos/"
  },
  {
   "id": "e-anim-assemble",
   "from": "anim",
   "to": "assemble",
   "label": "build/",
   "variant": "emphasis"
  },
  {
   "id": "e-assemble-qa",
   "from": "assemble",
   "to": "qa"
  },
  {
   "id": "e-qa-deliver",
   "from": "qa",
   "to": "deliver",
   "label": "pass",
   "variant": "emphasis"
  },
  {
   "id": "e-qa-anim",
   "from": "qa",
   "to": "anim",
   "label": "redo only the broken segment",
   "role": "return",
   "variant": "dashed"
  }
 ],
 "cards": [
  {
   "dot": "cyan",
   "title": "Division of labour",
   "items": [
    "The AI video model only handles people: appearance, expression, speech",
    "Text, numbers, code, app screens and subtitles are always generated by code"
   ]
  },
  {
   "dot": "amber",
   "title": "Two routes",
   "items": [
    "Flow route: live-action shots + animation; videos cost credits",
    "Animation-only route: skip live-action shots, title cards replace the presenter, 0 credits"
   ]
  }
 ]
}